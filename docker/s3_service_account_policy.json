{
  "Version": "2012-10-17",
  "Statement":
    [
      {
        "Effect": "Allow",
        "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
        ],
        "Resource": "arn:aws:s3:::spp-unit-bundles-*"
      },
      {
        "Effect": "Allow",
        "Action":
          [
            "s3:GetObject",
            "s3:GetObjectVersion",
            "s3:PutObject",
            "s3:AbortMultipartUpload",
            "s3:ListMultipartUploadParts",
            "s3:DeleteObject"
          ],
        "Resource": "arn:aws:s3:::spp-unit-bundles-*/*"
      },
      {
          "Effect": "Deny",
          "Action": [
              "s3:DeleteObjectVersion"
          ],
          "Resource": "arn:aws:s3:::spp-unit-bundles-*/*"
      }
    ]
}
