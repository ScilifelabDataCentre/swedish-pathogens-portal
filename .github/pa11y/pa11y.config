{
    "defaults": {
        "reporters": [
            "cli",
            ["json", { "fileName": "./pa11y-results.json" }]
        ],
        "rules": ["Principle1.Guideline1_3.1_3_1_AAA"],
        "hideElements": "div.plotly",
        "chromeLaunchConfig": {
            "args": ["--disable-dev-shm-usage", "--no-sandbox"],
            "executablePath": "/usr/bin/google-chrome",
            "ignoreHTTPSErrors": true
        }
    },
    "concurrency": 3
}
