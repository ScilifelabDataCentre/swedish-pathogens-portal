{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabled": true,
  "timezone": "Europe/Stockholm",
  "enabledManagers": [
    "dockerfile",
    "docker-compose",
    "github-actions",
    "pep621",
    "pre-commit",
    "pyenv"
  ],
  "vulnerabilityAlerts": {
    "vulnerabilityFixStrategy": "highest"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-8 * * TUE"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "non-major dependencies",
      "description": "Group all non-major updates into one PR, Tuesday morning.",
      "schedule": ["* 0-8 * * TUE"]
    },
    {
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit", "astral-sh/ruff-action"],
      "groupName": "ruff",
      "description": "Ruff is pinned in pyproject.toml, pre-commit and CI; bump them together."
    }
  ]
}
