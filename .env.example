# Django settings
SECRET_KEY=<required>
ADMIN_URL=<required-for-production>
MEDIA_ROOT=<required-for-production>
ALLOWED_HOSTS=<required-for-production>
CSRF_TRUSTED_ORIGINS=<required-for-production>

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# REVIEW: Security (prod toggles)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# REVIEW Gunicorn (prod)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# S3 storage settings for portal data files
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=s3-service-account
S3_SECRET_ACCESS_KEY=password
S3_BUCKETS=spp-unit-bundles-1,spp-unit-bundles-2

# Optional local dev settings

# set to 'true' if you wanna
# use 'graph_models' command
# of 'django-extensions'
with_pygraphviz=false
