# Django settings
SECRET_KEY=<required>
MEDIA_ROOT=<required-for-production>
ALLOWED_HOSTS=<required-for-production>
CSRF_TRUSTED_ORIGINS=<required-for-production>
INCLUDE_DJANGO_ADMIN=<not-required-and-defaults-to-false-in-production>

# Required for production if INCLUDE_DJANGO_ADMIN is true;.
DJANGO_ADMIN_URL=<some-desired-url>

# Optional; default /app/private/liver_resource_sessions (must be writable, not under MEDIA_ROOT)
# LIVER_SESSION_ROOT=/app/private/liver_resource_sessions

# Wagtail settings
WAGTAILADMIN_URL=<required-for-production>
WAGTAILADMIN_BASE_URL=<required-for-production>

# Database (PostgreSQL)
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=spp

# REVIEW: Security (prod toggles)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# REVIEW Gunicorn (prod)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Email. Required in production (no defaults, so a missing value fails at
# startup): DEFAULT_FROM_EMAIL must be an @scilifelab.se address; and
# CONTACT_RECIPIENT_EMAIL is where contact-form mail is delivered.
DEFAULT_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=

# Optional overrides (commented = use the settings default). Prod defaults to
# smtp-relay.gmail.com:587; USER/PASSWORD stay empty (relay uses IP allowlist).
# Dev uses mailpit — Docker sets EMAIL_HOST=mailpit for you
# (`docker compose --profile mailpit up`); devbox uses 127.0.0.1:1025.
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USE_TLS=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# No SMTP service at all? Print mail to stdout instead:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional local dev settings

# set to 'true' if you wanna
# use 'graph_models' command
# of 'django-extensions'
with_pygraphviz=false
