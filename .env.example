# Django settings
SECRET_KEY=<required>
ADMIN_URL=<required-for-production>
MEDIA_ROOT=<required-for-production>
# Optional; default /app/private/liver_resource_sessions (must be writable, not under MEDIA_ROOT)
# LIVER_SESSION_ROOT=/app/private/liver_resource_sessions
ALLOWED_HOSTS=<required-for-production>
CSRF_TRUSTED_ORIGINS=<required-for-production>

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# REVIEW: Security (prod toggles)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# REVIEW Gunicorn (prod)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Email — the settings modules build Django 6.1's MAILERS dict from the env
# names below, so these keys are unchanged from the pre-MAILERS layout.
#
# Required in production (no default): the sender. A missing value fails at
# settings load rather than at the first send. The Workspace relay rejects any
# From: outside its domain, so this must be an @scilifelab.se address.
DEFAULT_FROM_EMAIL=

# Prod overrides. EMAIL_HOST/EMAIL_PORT/EMAIL_USE_TLS default to
# smtp-relay.gmail.com:587 + STARTTLS; set them only for a staging relay or a
# relay swap. EMAIL_HOST_USER/EMAIL_HOST_PASSWORD stay empty while the relay
# authenticates by IP allowlist — fill them in if "Require SMTP
# Authentication" is ever enabled.
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USE_TLS=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# CONTACT_RECIPIENT_EMAIL=

# Dev defaults to mailpit on 127.0.0.1:1025, captured at http://localhost:8025/
# (`devbox run hub-up`, or `docker compose up mailpit`). Inside Docker Compose
# the service name resolves on the network, so use EMAIL_HOST=mailpit.
# EMAIL_HOST=mailpit
# For fast iteration with no service at all, print mail to stdout instead:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional local dev settings

# set to 'true' if you wanna
# use 'graph_models' command
# of 'django-extensions'
with_pygraphviz=false
